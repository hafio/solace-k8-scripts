# docker secrets for container solace -- CONTAINS SECRET VALUES.
# Run on this host to create them; `deploy` creates the same ones itself.
mkdir -p -m 700 ./solace-secrets
( umask 077; printf '%s' 'pa'\''ss "w" $ord' > ./solace-secrets/solace-admin-password )
( umask 077; printf '%s' 'Q0hBTkdFLU1FLXByZXNoYXJlZC1rZXktYmFzZTY0' > ./solace-secrets/solace-redundancy-psk )
