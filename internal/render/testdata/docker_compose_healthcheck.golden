services:
  solace:
    image: registry.example.com/solace-pubsub-standard:10.26.0.5
    container_name: solace
    hostname: solace-primary
    user: "0:0"
    restart: always
    shm_size: 1g
    ulimits:
      nofile:
        soft: 2448
        hard: 1048576
      memlock: -1
      core: -1
    healthcheck:
      test: ["CMD", "curl", "-fs", "http://localhost:5550/health-check/readiness"]
      interval: 5s
      timeout: 5s
      retries: 3
      start_period: 60s
    network_mode: host
    volumes:
      - "/opt/solace/data:/var/lib/solace:Z"
      - "certs/tls.crt:/run/secrets/tls.crt:ro"
    environment:
      routername: "solace-primary"
      nodetype: "message_routing"
      redundancy_activestandbyrole: "primary"
      redundancy_enable: "yes"
      configsync_enable: "yes"
      redundancy_group_node_solace-primary_connectvia: "10.0.0.11"
      redundancy_group_node_solace-primary_nodetype: "message_routing"
      redundancy_group_node_solace-backup_connectvia: "10.0.0.12"
      redundancy_group_node_solace-backup_nodetype: "message_routing"
      redundancy_group_node_solace-monitor_connectvia: "10.0.0.13"
      redundancy_group_node_solace-monitor_nodetype: "monitoring"
      configsync_tls_enable: "yes"
      redundancy_matelink_tls_enable: "yes"
      tls_servercertificate_filepath: "/run/secrets/tls.crt"
      system_scaling_maxconnectioncount: "1000"
      system_scaling_maxqueuemessagecount: "100"
      messagespool_maxspoolusage: "100000"
      username_admin_globalaccesslevel: "admin"
      username_admin_passwordfilepath: "/run/secrets/username_admin_password"
      redundancy_authentication_presharedkey_keyfilepath: "/run/secrets/redundancy_authentication_presharedkey_key"
    secrets:
      - source: solace-admin-password
        target: username_admin_password
      - source: solace-redundancy-psk
        target: redundancy_authentication_presharedkey_key
secrets:
  solace-admin-password:
    environment: SOLACE_ADMIN_PASSWORD
  solace-redundancy-psk:
    environment: SOLACE_REDUNDANCY_PSK
