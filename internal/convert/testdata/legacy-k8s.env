#!/bin/bash
# Legacy bash env fixture for the converter tests -- the pre-Go format that
# bash/000-env.sh sourced. It lives here rather than pointing at bash/env/sample
# because the bash/ tree is gitignored: a fresh CI checkout has no such file.
#
# It deliberately exercises every assignment form the old format used: quoted and
# bare scalars, a trailing comment, an indexed array, an associative array, a
# ${VAR} back-reference, and a bash-only variable that must be dropped silently.
#
# KUBE carries a multi-word value on purpose: the bash scripts expanded it
# unquoted, so it could hold a whole kubectl profile, and k8s.runtime has to
# preserve that. EXDIR is the bash-only variable dropped without a warning.

KUBE="kubectl --kubeconfig /home/localadmin/.kubeconfig-dev"
EXDIR="."

######################## IMAGE REPOSITORY ########################

IMAGEREPO_SECRET="registry-pull-secret"
IMAGEREPO_HOST="localhost"
IMAGEREPO_USER="docker-user"
IMAGEREPO_PASS="docker-pass"

############################ OPERATOR ############################

SOLOP_CPU="500m"
SOLOP_MEM="512Mi"

############################# BROKER #############################

SOLBK_NAME="solace-broker"
SOLBK_NS="solace-namespace"
SOLBK_IMAGE="solace-pubsub-standard"
SOLBK_IMG_TAG="latest"
SOLBK_REDUNDANCY="true"
SOLBK_UPDATE_STRATEGY="automatedRolling"

SOLBK_SCALING_MAXCONN="100"
SOLBK_SCALING_MAXPOOL="10000"
SOLBK_SCALING_MAXQMSG="100"
SOLBK_SCALING_MAXKAFKABRIDGE="0"
SOLBK_SCALING_MAXKAFKACONN="0"
SOLBK_SCALING_MAXBRIDGE="25"
SOLBK_SCALING_MAXSUB="50000"
SOLBK_SCALING_MAXGMSSIZE="10"

SOLBK_MSGNODE_CPU="2"
SOLBK_MSGNODE_MEM="3410Mi"

SOLBK_STORAGECLASS="solace-storage-class"
SOLBK_STORAGE_MSGNODE="16100Mi"
SOLBK_STORAGE_MONNODE="2300Mi"

SOLBK_ADM_PASS="adminpassword123"
SOLBK_MON_PASS="monitorpassword123"
SOLBK_USR_SECRET="solace-cli-secret"

SOLBK_TLS_CERT="/path/to/tls.crt"
SOLBK_TLS_CERTKEY="/path/to/tls.key"
SOLBK_TLS_CERTCAS=(
  "/path/to/ca/cert"
)

# Anti-affinity defaults to the broker's own namespace via a back-reference.
SOLBK_ANTIAFFINITY_NS=("${SOLBK_NS}")
SOLBK_ANTIAFFINITY_WT=100

SOLBK_DIAG_DIR="/path/to/diag-configs/dir"

SOLBK_DOMAINCERT_FOLDER="/path/to/domain/ca"
declare -A SOLBK_DOMAINCERT_FILES=(
	[CERT_NAME]="cert.crt"
)

SOLBK_CLISCRIPTS_FOLDER="cliscripts"

REPL_MATE=mate-virtual-router-name # script detects if "v:" is present, adding it here is optional.
REPL_CONN_SSL=("host:port" "host1:port1" "host2:port2")
REPL_PSK="" # script will generate if left blank
