# Generated by `solace-util convert` from testdata/legacy-k8s.env.
# Review before use: secrets are carried over verbatim, and any value the
# bash bootstrap defaulted rather than the env file setting is absent here
# (the Go defaults apply instead). See env/sample.yaml for the full schema.

redundancy: "yes"

image:
  repo: solace-pubsub-standard
  tag: latest
  registry: localhost
  pullSecret: registry-pull-secret
  user: docker-user
  pass: docker-pass

admin:
  pass: adminpassword123
  monitorPass: monitorpassword123

tls:
  cert: "/path/to/tls.crt"
  certKey: "/path/to/tls.key"
  cas:
    - "/path/to/ca/cert"

scaling:
  maxConnections: 100
  maxQueueMessages: 100
  maxSpoolUsageMB: 10000
  maxKafkaBridge: 0
  maxKafkaConnections: 0
  maxBridges: 25
  maxSubscriptions: 50000
  maxGuaranteedMsgMB: 10

replication:
  mate: mate-virtual-router-name
  connSsl:
    - "host:port"
    - "host1:port1"
    - "host2:port2"

broker:
  cliScriptsFolder: cliscripts
  diagDir: "/path/to/diag-configs/dir"
  domainCerts:
    folder: "/path/to/domain/ca"
    files:
      CERT_NAME: cert.crt

kubernetes:
  runtime: "kubectl --kubeconfig /home/localadmin/.kubeconfig-dev"
  name: solace-broker
  namespace: solace-namespace
  adminSecret: solace-cli-secret
  updateStrategy: automatedRolling
  storage:
    class: solace-storage-class
    msgNode: "16100Mi"
    monNode: "2300Mi"
  msgNode:
    mem: "3410Mi"
  operator:
    cpu: "500m"
    mem: "512Mi"
  placement:
    antiAffinityNamespaces:
      - solace-namespace
    antiAffinityWeight: 100
